# Elysium unified-kernel compatibility configuration.
#
# This file does not replace config/core.toml or config/models.toml in the
# current runtime. Core HTTP/storage/permissions still come from core.toml and
# production model routing still comes from models.toml. Do not create this
# file unless a subsystem-specific document explicitly requires it.

[runtime]
log_level = "INFO"
db_path = "data/elysium.db"
data_dir = "data"
plugins_dir = "plugins"
shutdown_timeout = 15.0
force_shutdown_after = 5.0
process_workers = 4
trust_env = true

# ─── LLM 配置 ───────────────────────────────────
# providers: API 提供商
# models: 模型实例（引用 provider）
# routing: 路由名 → 模型名 映射

[llm.providers]
# 示例（OpenAI 兼容接口）：
# [llm.providers.my_provider]
# base_url = "https://api.openai.com/v1"
# api_key = "${OPENAI_API_KEY}"
# client_type = "openai"
# max_retry = 3
# timeout = 60

[llm.models]
# 示例：
# [llm.models.main]
# provider = "my_provider"
# model = "gpt-4o"
# max_tokens = 8192
# temperature = 0.7
#
# [llm.models.fast]
# provider = "my_provider"
# model = "gpt-4o-mini"
# max_tokens = 4096

[llm.routing]
# 路由名 → 模型名。任务名参见 docs/architecture/LLM内核.md
# core = "main"       # 心跳/核心推理
# expression = "main" # 对话生成
# agent = "main"      # 子代理
# utility = "fast"    # 轻量杂务
default = "main"

# ─── HTTP 服务 ──────────────────────────────────

[http]
enabled = true
host = "127.0.0.1"
port = 18000
api_keys = []  # 留空禁用认证（不推荐生产环境）

# ─── 权限 ───────────────────────────────────────

[permission]
owner_list = []  # 格式：["qq:123456789", "feishu:ou_xxx"]
default_level = "user"
strict_mode = true
cache_ttl = 300
