# Elysium unified model registry (LiteLLM-style)
# Copy to config/models.toml and replace both provider credentials locally.
# This file is the sole authority for production automatic task routing.
# Startup fails on invalid references; it never falls back to model.toml.
# Priority is defined only by each tasks.*.models array, from left to right.

[providers.NexusAI]
base_url = "http://localhost:3000/v1"
api_key = "replace-with-new-api-token"
client_type = "openai"
max_retry = 3
timeout = 120
retry_interval = 5

[providers.LocalRouter]
base_url = "http://127.0.0.1:8849/v1"
api_key = "replace-with-local-router-token"
client_type = "openai"
max_retry = 1
timeout = 5
retry_interval = 2

# Non-generative models
[models."sensevoice-small"]
provider = "NexusAI"
id = "FunAudioLLM/SenseVoiceSmall"
ctx = 4096

[models."bge-m3"]
provider = "NexusAI"
id = "BAAI/bge-m3"
ctx = 4096

# Cloud reasoning models. The local relay exposes health-qualified abilities.
# Qualified non-multimodal tasks temporarily prioritize the formal DeepSeek V4
# Flash route, followed by Luna -> Terra -> Sol and cross-family fallbacks.
[models."gpt-5.6-luna"]
provider = "NexusAI"
id = "gpt-5.6-luna"
ctx = 300000
stream = true
vision = true
extra = { reasoning_effort = "high" }

[models."gpt-5.6-terra"]
provider = "NexusAI"
id = "gpt-5.6-terra"
ctx = 300000
stream = true
vision = true
extra = { reasoning_effort = "high" }

[models."gpt-5.6-sol"]
provider = "NexusAI"
id = "gpt-5.6-sol"
ctx = 300000
stream = true
vision = true
extra = { reasoning_effort = "high" }

# The local relay maps this public alias to Volcengine Coding Plan's
# ark-code-latest. Direct upstream deepseek-v4-flash is the preview route.
[models."deepseek-v4-flash"]
provider = "NexusAI"
id = "deepseek-v4-flash"
ctx = 1000000
extra = { thinking = { type = "enabled" } }

[models."MiMo-V2.5-Pro"]
provider = "NexusAI"
id = "mimo-v2.5-pro"
ctx = 1000000
extra = { enable_thinking = true }

[models."MiMo-V2.5"]
provider = "NexusAI"
id = "mimo-v2.5"
ctx = 1000000
vision = true
audio = true
video = true
extra = { enable_thinking = true }

[models."qwen3.7-plus"]
provider = "NexusAI"
id = "qwen3.7-plus"
ctx = 1000000
vision = true
video = true
extra = { thinking = { type = "enabled" } }

[models."gemini-3.5-flash"]
provider = "NexusAI"
id = "gemini-3.5-flash"
ctx = 1000000
vision = true
audio = true
video = true

[models."claude-sonnet-5"]
provider = "NexusAI"
id = "claude-sonnet-5"
ctx = 1000000
vision = true
extra = { thinking = { budget_tokens = 16000, type = "enabled" } }

# Registered for explicit manual use. Runtime tasks remain cloud-first.
[models."qwen3-0.6b-router"]
provider = "LocalRouter"
id = "qwen3-0.6b-router"
ctx = 2048
extra = { enable_thinking = false }

# Generative budgets include hidden reasoning and final output. Qualified
# non-multimodal tasks temporarily prefer the formal DeepSeek V4 Flash route;
# GPT priority then remains Luna -> Terra -> Sol. Expression requires vision
# capability and therefore excludes text-only models. Remove an unhealthy
# ability from automatic tasks only after an end-to-end probe confirms the
# fault. qwen3.7-plus remains registered for explicit recovery probes only.
[tasks.core]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5-Pro", "gemini-3.5-flash", "MiMo-V2.5", "claude-sonnet-5"]
tokens = 32000
temp = 0.7
context_tokens = 100000
attempt_timeout_seconds = 180
model_extra = { "deepseek-v4-flash" = { thinking = { type = "enabled" } }, "gpt-5.6-luna" = { reasoning_effort = "high" }, "gpt-5.6-terra" = { reasoning_effort = "high" }, "gpt-5.6-sol" = { reasoning_effort = "high" }, "MiMo-V2.5-Pro" = { enable_thinking = true }, "MiMo-V2.5" = { enable_thinking = true }, "claude-sonnet-5" = { thinking = { budget_tokens = 16000, type = "enabled" } } }

[tasks.learning]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5-Pro", "gemini-3.5-flash", "MiMo-V2.5", "claude-sonnet-5"]
tokens = 32000
temp = 0.7
context_tokens = 100000
attempt_timeout_seconds = 300
model_extra = { "deepseek-v4-flash" = { thinking = { type = "enabled" } }, "gpt-5.6-luna" = { reasoning_effort = "high" }, "gpt-5.6-terra" = { reasoning_effort = "high" }, "gpt-5.6-sol" = { reasoning_effort = "high" }, "MiMo-V2.5-Pro" = { enable_thinking = true }, "MiMo-V2.5" = { enable_thinking = true }, "claude-sonnet-5" = { thinking = { budget_tokens = 16000, type = "enabled" } } }

[tasks.expression]
models = ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "gemini-3.5-flash", "MiMo-V2.5", "claude-sonnet-5"]
tokens = 32000
temp = 0.8
context_tokens = 200000
extra = { parallel_tool_calls = true }
model_extra = { "gpt-5.6-luna" = { reasoning_effort = "low" }, "gpt-5.6-terra" = { reasoning_effort = "low" }, "gpt-5.6-sol" = { reasoning_effort = "low" }, "MiMo-V2.5" = { enable_thinking = false }, "claude-sonnet-5" = { thinking = { budget_tokens = 2048, type = "enabled" } } }

[tasks.witness]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5", "gemini-3.5-flash"]
tokens = 16000
temp = 0.7
context_tokens = 100000
attempt_timeout_seconds = 300

[tasks.agent]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5-Pro", "gemini-3.5-flash", "MiMo-V2.5", "claude-sonnet-5"]
tokens = 32000
temp = 0.7
context_tokens = 200000
attempt_timeout_seconds = 300

[tasks.utility]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5", "gemini-3.5-flash"]
tokens = 16000
temp = 0.7
context_tokens = 64000
attempt_timeout_seconds = 180

[tasks.vision]
models = ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5", "gemini-3.5-flash"]
tokens = 16000
temp = 0.7
context_tokens = 100000

[tasks.voice]
models = ["sensevoice-small"]
tokens = 8192
temp = 0.7

[tasks.embedding]
models = ["bge-m3"]
tokens = 8192
temp = 0.7

[tasks.router]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5", "gemini-3.5-flash"]
tokens = 8192
temp = 0.3
context_tokens = 32000
model_extra = { "deepseek-v4-flash" = { thinking = { type = "disabled" } }, "gpt-5.6-luna" = { reasoning_effort = "low" }, "gpt-5.6-terra" = { reasoning_effort = "low" }, "gpt-5.6-sol" = { reasoning_effort = "low" }, "MiMo-V2.5" = { enable_thinking = false } }

[tasks.router_context_projection]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5", "gemini-3.5-flash"]
tokens = 16000
temp = 0.2
context_tokens = 100000

[tasks.live]
models = ["deepseek-v4-flash", "gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol", "MiMo-V2.5-Pro", "gemini-3.5-flash", "MiMo-V2.5", "claude-sonnet-5"]
tokens = 32000
temp = 0.75
context_tokens = 100000
