{
  "name": "Livestream",
  "version": "2.0.0",
  "description": "可追溯的 B站直播导演、语音舞台与记忆闭环",
  "author": "Elysium",
  "license": "GPL-3.0",
  "min_core_version": "1.0.0",
  "entry_point": "plugin.py",
  "keywords": ["livestream", "bilibili", "director", "tts", "obs"],
  "categories": ["entertainment"],
  "dependencies": {
    "plugins": [
      "life_engine"
    ],
    "components": []
  },
  "python_dependencies": [
    "aiosqlite",
    "brotli",
    "fastapi",
    "httpx",
    "json-repair",
    "pydantic",
    "websockets"
  ],
  "include": [
    {
      "component_type": "router",
      "component_name": "livestream",
      "dependencies": [],
      "enabled": true
    }
  ],
  "dependencies_required": true,
  "config": {
    "path": "config/plugins/Livestream/config.toml",
    "reloadable": false
  }
}
